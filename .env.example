# Application
NODE_ENV=development
PORT=5000
# Host port mapping for Docker backend (auto-managed by scripts/select-backend-port.sh)
BACKEND_PORT=5000

# Security — change these before deploying to production!
JWT_SECRET=your-super-secret-jwt-key-change-this
ENCRYPTION_KEY=32-char-hex-encryption-key-here!!

# Database
DB_PATH=./data/email-client.db

# CORS / Frontend
FRONTEND_URL=http://localhost:3000

# GitHub (used by the auto-updater)
GITHUB_OWNER=LegoPuck-orginal
GITHUB_REPO=email-client

# Email sending defaults (optional — users configure their own accounts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
